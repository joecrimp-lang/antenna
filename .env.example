# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
# Optional: override the model used for research (must support the web_search tool)
OPENAI_MODEL=gpt-5.6-luna
# Optional: cap the number of companies a run processes (e.g. 5 for a pilot).
# Unset means no limit — all companies in the watchlist are processed.
RESEARCH_COMPANY_LIMIT=
# Optional: skip this many companies (in rank order) before applying the
# limit above, e.g. LIMIT=5 + OFFSET=5 processes the companies ranked 6-10.
# Unset means start from the beginning of the watchlist.
RESEARCH_COMPANY_OFFSET=
# Optional (Phase 2A): filter to one organisation_type — buyer, vendor,
# platform, or technology_provider. Unset means no filter. Used by
# scripts/runControlledResearchTest.ts for the buyer/vendor controlled test
# batches; combine with RESEARCH_COMPANY_LIMIT above the same way.
# Note: research_enabled=true is ALWAYS required regardless of this filter
# — a company with research_enabled=false is never selected, filter or not.
RESEARCH_ORG_TYPE=

# Resend
RESEND_API_KEY=
# Must be a verified domain/sender in your Resend account
RESEND_FROM_EMAIL=digest@yourdomain.com
# Who receives the daily digest
DIGEST_EMAIL_TO=joe.crimp@gmail.com

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" to protect the cron route.
# Generate with: openssl rand -hex 32
# REQUIRED on any deployed (Vercel) environment — the cron route fails closed
# (rejects every request) if this is unset there. Optional only for pure
# local development (next dev with no VERCEL env present).
CRON_SECRET=

# Operator-only secret for POST /api/run-now (manual research trigger).
# Generate with: openssl rand -hex 32
# REQUIRED — this endpoint always fails closed (401) if unset, in every
# environment. Never exposed to the browser: only read server-side, inside
# the route handler. Use it as "Authorization: Bearer <value>" when calling
# the endpoint yourself (e.g. via curl) — there is no operator UI for this yet.
ADMIN_RUN_SECRET=
