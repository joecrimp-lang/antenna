# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
# Optional: override the model used for research (must support the web_search tool)
OPENAI_MODEL=gpt-5.6

# Resend
RESEND_API_KEY=
# Must be a verified domain/sender in your Resend account
RESEND_FROM_EMAIL=digest@yourdomain.com
# Who receives the daily digest
DIGEST_EMAIL_TO=joe.crimp@gmail.com

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" to protect the cron route.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Shared secret WE attach ourselves when a batch triggers the next one via
# /api/continue-research. Vercel does NOT attach CRON_SECRET to these
# self-made requests, so this is a separate value.
# Generate with: openssl rand -hex 32
INTERNAL_TRIGGER_SECRET=

# Optional: base URL this app uses to call itself when chaining batches
# (e.g. https://antenna.vercel.app). Falls back to Vercel's own VERCEL_URL
# env var (set automatically on Vercel), then to http://localhost:3000 for
# local dev. You normally don't need to set this on Vercel.
APP_BASE_URL=
