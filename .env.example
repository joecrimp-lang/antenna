# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
# Optional: override the model used for research (must support the web_search tool)
OPENAI_MODEL=gpt-5.6

# Resend
RESEND_API_KEY=
# Must be a verified domain/sender in your Resend account
RESEND_FROM_EMAIL=digest@yourdomain.com
# Who receives the daily digest
DIGEST_EMAIL_TO=joe.crimp@gmail.com

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" to protect the cron route.
# Generate with: openssl rand -hex 32
CRON_SECRET=
